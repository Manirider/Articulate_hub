# AI Communication Coach - Environment Configuration Template
# Copy this file to .env and fill in your actual values
# DO NOT commit .env files with real secrets to git

# ============================================
# Application Settings
# ============================================
APP_NAME="AI Communication Coach"
ENVIRONMENT=development

# ============================================
# Database - PostgreSQL (Required for Production)
# For local development with Docker: postgresql+asyncpg://postgres:postgres@localhost:5432/aicoach
# For SQLite (dev only): sqlite+aiosqlite:///./local-dev.db
# ============================================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aicoach
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# ============================================
# Redis - Required for caching, sessions, job queues
# ============================================
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=50

# ============================================
# Security - JWT Authentication
# Generate a strong secret: openssl rand -hex 32
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
BCRYPT_ROUNDS=12

# ============================================
# AI Services - OpenAI (Required for AI features)
# Get API key from: https://platform.openai.com/api-keys
# ============================================
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-3.5-turbo

# ============================================
# Speech-to-Text - Gladia API (Required for transcription)
# Get API key from: https://app.gladia.io/
# ============================================
GLADIA_API_KEY=your-gladia-api-key-here

# Whisper Model for local fallback (tiny, base, small, medium, large)
WHISPER_MODEL=tiny

# ============================================
# OAuth - Google (Optional - for Google login)
# Get credentials from: https://console.cloud.google.com/apis/credentials
# ============================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ============================================
# OAuth - GitHub (Optional - for GitHub login)
# Get credentials from: https://github.com/settings/applications/new
# ============================================
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback

# ============================================
# Email Service - Resend (Optional - for email notifications)
# Get API key from: https://resend.com/
# ============================================
RESEND_API_KEY=your-resend-api-key

# ============================================
# Frontend URL (for CORS and redirects)
# ============================================
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_PER_MINUTE=120

# ============================================
# File Upload Settings
# ============================================
UPLOAD_DIR=uploads
RECORDINGS_DIR=recordings
MAX_UPLOAD_SIZE_MB=50

# ============================================
# Security Settings
# ============================================
MAX_FAILED_LOGIN_ATTEMPTS=5
FAILED_LOGIN_WINDOW_MINUTES=15

# ============================================
# Monitoring (Optional)
# ============================================
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ============================================
# Local Development Only
# ============================================
# Set to 'true' to enable debug mode (never in production)
DEBUG=false

# Celery worker settings (for background AI jobs)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
